<!doctype html><html lang="ms"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sistem Rekod Rumah SINAR</title><script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-app.js"></script><script src="https://www.gstatic.com/firebasejs/8.10.0/firebase-database.js"></script><style>:root{--p:#2563eb;--g:#16a34a;--t:#0f766e;--o:#ea580c;--v:#7c3aed;--d:#0f172a;--m:#64748b;--bg:#f1f5f9}*{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:Arial;color:var(--d)}.top{background:linear-gradient(135deg,#2563eb,#0f766e);color:#fff;padding:22px 15px;text-align:center}.top h1{margin:0;font-size:1.25rem}.top p{margin:6px 0 0;font-size:.8rem}.wrap{max-width:850px;margin:auto;padding:15px}.card{background:#fff;border:1px solid #e2e8f0;border-radius:20px;padding:17px;margin-bottom:14px;box-shadow:0 4px 15px #0000000a}.title{font-weight:800;margin-bottom:12px}.muted{color:var(--m);font-size:.8rem}.notice{background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;padding:12px;border-radius:13px;font-size:.78rem;line-height:1.5}.btn{border:0;border-radius:13px;padding:12px 15px;color:#fff;font-weight:800;cursor:pointer}.primary{background:var(--p)}.green{background:var(--g)}.purple{background:var(--v)}input,select,textarea{width:100%;padding:11px;border:1px solid #cbd5e1;border-radius:12px;margin-top:5px;font:inherit}label{font-size:.78rem;font-weight:800;color:#475569}.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:9px}.stat{padding:14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:16px}.stat b{display:block;font-size:1.4rem;margin-top:4px}.hidden{display:none}.badge{display:inline-block;padding:5px 9px;border-radius:9px;background:#dbeafe;color:#1d4ed8;font-size:.72rem;font-weight:800}.profile{display:flex;justify-content:space-between;gap:10px;align-items:center}.score{font-size:1.8rem;font-weight:900;color:var(--p)}.status{text-align:center;padding:10px;border-radius:12px;font-size:.8rem;font-weight:800}.ok{background:#dcfce7;color:#166534}.warn{background:#fff7ed;color:#9a3412}.solat{padding:12px;text-align:center;border:2px solid #e2e8f0;border-radius:13px;font-weight:800;cursor:pointer;background:#fff}.solat.on{background:#dcfce7;border-color:#22c55e;color:#15803d}.solatgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:7px}.history{border-left:4px solid var(--p);background:#f8fafc;padding:10px 12px;border-radius:10px;margin-top:8px}.nav{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;position:sticky;bottom:8px}.nav button{border:0;background:#fff;border-radius:12px;padding:10px 4px;font-size:.7rem;font-weight:800;box-shadow:0 2px 8px #0001}@media(max-width:600px){.row{grid-template-columns:1fr}.solatgrid{grid-template-columns:repeat(2,1fr)}} </style></head><body>
<div class="top"><h1>🌟 SISTEM REKOD RUMAH SINAR</h1><p>Rekod Kebaikan • Solat 5 Waktu • Bacaan Al-Quran / Iqra'</p></div><div class="wrap">
<div id="setup" class="card"><div class="title">👨‍👩‍👧 Pilih Anak</div><div class="notice">Imbas kad NFC anak atau pilih nama anak. Semua rekod dalam sistem ini ialah <b>rekod di rumah</b> dan tidak mengubah rekod rasmi guru.</div><button class="btn primary" style="width:100%;margin-top:10px" onclick="aktifNFC()">📡 AKTIFKAN NFC</button><select id="anak" onchange="pilih(this.value)"><option value="">-- Pilih Anak --</option></select><div id="nfcStatus" class="status warn" style="margin-top:10px">🔒 Belum memilih anak</div></div>
<div id="app" class="hidden"><div class="card"><div class="profile"><div><div class="muted">REKOD ANAK</div><h2 id="nama" style="margin:4px 0">-</h2><span id="kelas" class="badge">-</span></div><div style="text-align:right"><div class="muted">MINIT KEBAIKAN HARI INI</div><div id="minit" class="score">0</div></div></div></div>
<section id="kebaikan"><div class="card"><div class="title">🤍 Rekod Kebaikan Anak</div><div class="notice">Masa kebaikan dicatat dalam <b>minit</b>, bukan merit.</div><div class="row" style="margin-top:10px"><div><label>Tarikh</label><input id="kt" type="date"></div><div><label>Minit</label><input id="km" type="number" min="1" placeholder="Contoh: 15"></div></div><label style="display:block;margin-top:10px">Jenis Kebaikan</label><select id="kj"><option>Membantu ibu bapa</option><option>Membantu adik-beradik</option><option>Mengemas rumah</option><option>Belajar tanpa disuruh</option><option>Menjaga kebersihan</option><option>Berbuat baik kepada orang lain</option><option>Amalan positif lain</option></select><label style="display:block;margin-top:10px">Catatan</label><textarea id="kc" rows="2" placeholder="Contoh: membantu mengemas dapur"></textarea><button class="btn green" style="width:100%;margin-top:10px" onclick="simpanKebaikan()">➕ SIMPAN KEBAIKAN</button></div><div class="card"><div class="title">📋 Kebaikan Hari Ini</div><div id="listK">Tiada rekod.</div></div></section>
<section id="solat" class="hidden"><div class="card"><div class="title">🕌 Rekod Solat 5 Waktu</div><label>Tarikh</label><input id="st" type="date" onchange="renderSolat()"><p class="muted">Tekan waktu yang telah ditunaikan.</p><div id="sg" class="solatgrid"></div><button class="btn green" style="width:100%;margin-top:10px" onclick="simpanSolat()">💾 SIMPAN REKOD SOLAT</button></div><div class="card"><div class="title">📊 Ringkasan Solat</div><div id="sr" class="stat">Belum direkodkan.</div></div></section>
<section id="bacaan" class="hidden"><div class="card"><div class="title">📖 Bacaan Al-Quran / Iqra'</div><div class="notice">Rekod ini ialah rekod bacaan di rumah. <b>Rekod guru tidak berubah.</b></div><label style="display:block;margin-top:10px">Tarikh</label><input id="bt" type="date" onchange="renderBacaan()"><div class="row" style="margin-top:10px"><div><label>Jenis</label><select id="bj" onchange="tukarJenis()"><option value="IQRA">IQRA'</option><option value="ALQURAN">AL-QURAN</option></select></div><div id="jb"><label>Jilid Iqra'</label><select id="jil"><option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option></select></div></div><div class="row" style="margin-top:10px"><div><label>Muka Surat Dari</label><input id="bd" type="number" min="1"></div><div><label>Muka Surat Hingga</label><input id="bh" type="number" min="1"></div></div><label style="display:block;margin-top:10px">Catatan</label><textarea id="bc" rows="2"></textarea><button class="btn purple" style="width:100%;margin-top:10px" onclick="simpanBacaan()">💾 SIMPAN BACAAN</button></div><div class="card"><div class="title">📚 Bacaan Hari Ini</div><div id="listB">Tiada rekod.</div></div></section>
<section id="ringkasan" class="hidden"><div class="card"><div class="title">📊 Ringkasan Hari Ini</div><div class="grid"><div class="stat">🤍 Minit Kebaikan<b id="sm">0</b><span class="muted">minit</span></div><div class="stat">🕌 Solat<b id="ss">0 / 5</b><span class="muted">waktu</span></div><div class="stat">📖 Bacaan<b id="sb">0</b><span class="muted">rekod</span></div></div></div><div class="card"><div class="title">🔒 Rekod Bacaan Guru</div><div id="guru" class="notice">-</div></div></section>
<div class="nav"><button onclick="view('kebaikan')">🤍<br>Kebaikan</button><button onclick="view('solat')">🕌<br>Solat</button><button onclick="view('bacaan')">📖<br>Bacaan</button><button onclick="view('ringkasan')">📊<br>Ringkasan</button></div></div></div>
<script>
const C={apiKey:'AIzaSyAejpV7AXCzbPKhsmSo3jSmzggjxZ8eK3o',authDomain:'sistem-merit-sk-melekek.firebaseapp.com',databaseURL:'https://sistem-merit-sk-melekek-default-rtdb.asia-southeast1.firebasedatabase.app',projectId:'sistem-merit-sk-melekek'};if(!firebase.apps.length)firebase.initializeApp(C);const db=firebase.database();let murid=[],anak=null,nfc=null,cacheSolat={};const W=['Subuh','Zohor','Asar','Maghrib','Isyak'];
const today=()=>new Date(Date.now()-new Date().getTimezoneOffset()*60000).toISOString().slice(0,10);const esc=x=>String(x??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));const root=()=>`rekodRumah/${anak.uid}`;const guru=m=>m.guruBacaan||{jenisBacaan:m.jenisBacaan||'IQRA',jilidIqra:m.jilidIqra||'1',mukaSurat:m.mukaSurat||'1'};
function init(){['kt','st','bt'].forEach(id=>document.getElementById(id).value=today());db.ref('pelajar').on('value',s=>{const d=s.val()||{};murid=Object.keys(d).map(uid=>({uid,...d[uid]}));const q=document.getElementById('anak'),old=q.value;q.innerHTML='<option value="">-- Pilih Anak --</option>';murid.sort((a,b)=>String(a.nama).localeCompare(String(b.nama))).forEach(m=>q.innerHTML+=`<option value="${esc(m.uid)}">${esc(m.nama)} — Tahun ${esc(m.tahun)} ${esc(m.namaKelas)}</option>`);q.value=old;if(anak)pilih(anak.uid,true)})}
function pilih(uid,r=false){const m=murid.find(x=>x.uid===uid);if(!m)return;anak=m;document.getElementById('anak').value=uid;document.getElementById('app').classList.remove('hidden');document.getElementById('nama').textContent=m.nama;document.getElementById('kelas').textContent=`Tahun ${m.tahun} ${m.namaKelas}`;document.getElementById('nfcStatus').className='status ok';document.getElementById('nfcStatus').textContent='🔓 Anak dipilih';renderAll()}
function view(id){if(!anak)return alert('Sila pilih anak dahulu.');['kebaikan','solat','bacaan','ringkasan'].forEach(x=>document.getElementById(x).classList.add('hidden'));document.getElementById(id).classList.remove('hidden');renderAll()}
async function aktifNFC(){if(!('NDEFReader'in window))return alert('Web NFC tidak disokong. Gunakan Android + Chrome.');if(nfc)return alert('NFC sudah aktif.');try{nfc=new NDEFReader();await nfc.scan();document.getElementById('nfcStatus').textContent='📡 NFC aktif — imbas kad anak';nfc.onreading=e=>{const uid=e.serialNumber.replace(/:/g,'').toUpperCase();if(murid.some(m=>m.uid===uid))pilih(uid);else alert('Kad belum didaftarkan.')}}catch(e){nfc=null;alert('Akses NFC ditolak.')}}
async function simpanKebaikan(){if(!anak)return;const tarikh=kt.value,minit=+km.value;if(!tarikh||!minit||minit<1)return alert('Sila isi tarikh dan minit.');await db.ref(root()+'/kebaikan').push({tarikh,minit,jenis:kj.value,catatan:kc.value,oleh:'IBUBAPA',timestamp:firebase.database.ServerValue.TIMESTAMP});km.value='';kc.value='';alert('Rekod kebaikan disimpan.');renderAll()}
async function renderK(){const d=(await db.ref(root()+'/kebaikan').once('value')).val()||{},t=kt.value,a=Object.values(d).filter(x=>x.tarikh===t).sort((a,b)=>(b.timestamp||0)-(a.timestamp||0)),n=a.reduce((s,x)=>s+(+x.minit||0),0);minit.textContent=n;listK.innerHTML=a.length?a.map(x=>`<div class="history"><b>🤍 ${esc(x.jenis)}</b><br><span class="badge">${x.minit} minit</span><div class="muted">${esc(x.catatan||'Tiada catatan')}</div></div>`).join(''):'<div class="muted">Tiada rekod.</div>'}
function renderSolat(){if(!anak)return;const d=cacheSolat[st.value]||{};sg.innerHTML=W.map(w=>`<div class="solat ${d[w]?'on':''}" onclick="tog('${w}')">${d[w]?'✅':'⬜'}<br>${w}</div>`).join('');sr.innerHTML=`<b style="font-size:1.5rem">${W.filter(w=>d[w]).length} / 5</b> waktu ditunaikan`}
function tog(w){cacheSolat[st.value]=cacheSolat[st.value]||{};cacheSolat[st.value][w]=!cacheSolat[st.value][w];renderSolat()}
async function simpanSolat(){await db.ref(root()+'/solat/'+st.value).set({...cacheSolat[st.value]||{},oleh:'IBUBAPA',updatedAt:firebase.database.ServerValue.TIMESTAMP});alert('Rekod solat disimpan.');renderAll()}
function tukarJenis(){jb.style.display=bj.value==='IQRA'?'block':'none'}
async function simpanBacaan(){const dari=+bd.value,hingga=+bh.value;if(!bt.value||!dari||!hingga||hingga<dari)return alert('Sila isi muka surat dengan betul.');await db.ref(root()+'/bacaan').push({tarikh:bt.value,jenisBacaan:bj.value,jilidIqra:bj.value==='IQRA'?jil.value:'-',mukaSuratDari:dari,mukaSuratHingga:hingga,catatan:bc.value,oleh:'IBUBAPA',timestamp:firebase.database.ServerValue.TIMESTAMP});bd.value='';bh.value='';bc.value='';alert('Rekod bacaan disimpan.');renderAll()}
async function renderB(){const d=(await db.ref(root()+'/bacaan').once('value')).val()||{},a=Object.values(d).filter(x=>x.tarikh===bt.value).sort((a,b)=>(b.timestamp||0)-(a.timestamp||0));listB.innerHTML=a.length?a.map(x=>`<div class="history"><b>${x.jenisBacaan==='ALQURAN'?'📗 AL-QURAN':`📖 IQRA' ${esc(x.jilidIqra)}`}</b><br>Muka surat ${x.mukaSuratDari} – ${x.mukaSuratHingga}<div class="muted">${esc(x.catatan||'Tiada catatan')}</div></div>`).join(''):'<div class="muted">Tiada rekod.</div>'}
async function renderR(){const t=today(),r=root(),[k,s,b]=await Promise.all([db.ref(r+'/kebaikan').once('value'),db.ref(r+'/solat/'+t).once('value'),db.ref(r+'/bacaan').once('value')]),kd=k.val()||{},sd=s.val()||{},bd=b.val()||{};sm.textContent=Object.values(kd).filter(x=>x.tarikh===t).reduce((a,x)=>a+(+x.minit||0),0);ss.textContent=`${W.filter(w=>sd[w]).length} / 5`;sb.textContent=Object.values(bd).filter(x=>x.tarikh===t).length;const g=guru(anak);guru.innerHTML=g.jenisBacaan==='ALQURAN'?`📗 Al-Quran — muka surat ${esc(g.mukaSurat)}`:`📖 Iqra' ${esc(g.jilidIqra)} — muka surat ${esc(g.mukaSurat)}`}
async function renderAll(){if(!anak)return;await renderK();renderSolat();await renderB();await renderR()}init();
</script></body></html>
